# Local PostgreSQL. Do not commit a real .env file.
DATABASE_URL=postgresql://crm:crm@localhost:5432/jenosize_crm

# Signs the demo session cookie. Use a long random value; this example is not a secret to reuse.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. When unset, the CRM copilot uses the deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# LINE Official Account. LINE_MODE=mock keeps sends on this machine.
# Set LINE_CHANNEL_SECRET before accepting webhooks. Leave the access token empty in mock mode.
# Put the real channel secret only in .env, never in git.
LINE_MODE=mock
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
